# syntax=docker/dockerfile:1.7
# Lokal testversion — installerer @bimo-dk/* fra lokal Verdaccio paa host:4873.
# Kræver at start.ps1 i nexus-test/ er koert foerst.

FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json tsconfig.json ./
RUN printf '@bimo-dk:registry=http://host.docker.internal:4873\nlegacy-peer-deps=true\n' > .npmrc
RUN npm install --no-audit --no-fund --legacy-peer-deps

COPY src ./src
RUN npm run build

FROM node:22-alpine
RUN apk add --no-cache wget
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app

COPY package*.json ./
RUN printf '@bimo-dk:registry=http://host.docker.internal:4873\nlegacy-peer-deps=true\n' > .npmrc
RUN npm install --omit=dev --no-audit --no-fund --legacy-peer-deps && \
    rm -f .npmrc && \
    npm cache clean --force

COPY --from=builder /app/dist ./dist
COPY src/data ./data

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1
CMD ["node", "dist/index.js"]
